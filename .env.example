# Copy to .env and fill in. NEVER commit .env.

# LLM provider: groq | openai | anthropic | google | ollama
# Example with Gemini (free tier, key from https://aistudio.google.com/apikey):
#   LLM_PROVIDER=google
#   LLM_MODEL=gemini-3.8-flash
# Several models, in order of preference (the next one answers when a model is overloaded,
# too slow or unavailable); an entry can name its own provider:
#   LLM_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,groq:openai/gpt-oss-120b
# Per-request timeout (seconds) and SDK retries per model:
#   LLM_TIMEOUT=60
#   LLM_MAX_RETRIES=1
# Free-tier Gemini content "is used to improve Google products": avoid real personal CVs.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Light model for job analysis, cover letter and interview questions (empty = main LLM).
# Free quotas are counted per model, so a second model spares the writer's daily quota.
LIGHT_PROVIDER=
LIGHT_MODEL=

# Judge model used by the Critic (optional; empty = same as the main LLM).
# Use a different model or family than the writer to reduce self-grading bias.
JUDGE_PROVIDER=
JUDGE_MODEL=
# Backup judge used if the judge keeps returning invalid output (empty = the main LLM).
JUDGE_FALLBACK_PROVIDER=
JUDGE_FALLBACK_MODEL=
# Attempts per structured call (analysis, writing, judging) before giving up / using the backup.
STRUCTURED_RETRIES=3

# Keys (only the ones for the providers you use are needed)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama (local, no key): LLM_PROVIDER=ollama, LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (multilingual, small, runs on CPU)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Critic loop
MAX_ITERATIONS=3
FAITHFULNESS_MIN=0.95
OVERALL_MIN=0.75

# Optional: raises GitHub API rate limit when ingesting repos
GITHUB_TOKEN=

OUTPUT_DIR=outputs
