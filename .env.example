# Copy to .env and fill in. NEVER commit .env.

# LLM provider: groq | openai | anthropic | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Keys (only the one for your provider is needed)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local, no key): LLM_PROVIDER=ollama, LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (multilingual, small, runs on CPU)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Critic loop
MAX_ITERATIONS=3
FAITHFULNESS_MIN=0.95
OVERALL_MIN=0.75

# Optional: raises GitHub API rate limit when ingesting repos
GITHUB_TOKEN=

OUTPUT_DIR=outputs
